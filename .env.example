# Copy to .env and fill in what you need:
#   cp .env.example .env
#
# Nothing here is required. The build reads the public S3 bucket anonymously, and
# once the warehouse is built, resolve, dimension and scoring all run offline.

# Optional: keep the ~27 GiB of built Parquet somewhere other than ./data
# (a build needs ~60 GiB free while step 3 sorts)
# OAM_DATA_DIR=/Volumes/data/oam

# Optional: DuckDB tuning for queries and the step 2 and 3 builds
# OAM_MEMORY_LIMIT=20GB
# OAM_THREADS=8
